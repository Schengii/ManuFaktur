# .claudeignore – Ignorierte Dateien und Verzeichnisse für Claude Code
# Verhindert Token-Verschwendung, Kontext-Überflutung und schützt vertrauliche Daten.

# 1. Schwere Archive & Rohdaten (über 560 MB)
archive_sources/
assets/imgTxt/

# 2. Abhängigkeiten & Lockfiles
node_modules/
package-lock.json

# 3. Minifizierte Produktions-Builds (Quellcode liegt in style.css, Home.js, assets/js/i18n.js)
style.min.css
Home.min.js
assets/js/i18n.min.js
assets/vendor/font-awesome/css/icons.min.css

# 4. Binäre Medienressourcen (Bilder, Schriften, Dokumente)
assets/images/
assets/fonts/
assets/documents/
assets/vendor/font-awesome/webfonts/
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.ico
*.pdf
*.vcf
*.woff
*.woff2
*.ttf
*.eot

# 5. Geheimnisse, Tokens & Umgebungsvariablen
.env
.env.*
*.env

# 6. Git, Vercel & Deployment-Metadaten
.git/
.vercel/

# 7. Test-Berichte, Playwright & Lighthouse CI
test-results/
playwright-report/
.playwright/
.lighthouseci/

# 8. OS- und Editor-Artefakte
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.vscode/
.idea/
