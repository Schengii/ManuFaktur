# ==============================================================================
# ManuFAKTUR Schenk – Umgebungsvariablen-Vorlage (.env.example)
# ==============================================================================
# Kopiere diese Datei nach .env für deine lokale Entwicklungsumgebung:
#   cp .env.example .env (oder in PowerShell: Copy-Item .env.example .env)
#
# WICHTIG: Echte Secrets und Tokens gehören NUR in .env / .env.local und
# dürfen NIEMALS in das Git-Repository eingecheckt werden!
# ==============================================================================

# Lokaler Entwicklungsserver (scripts/serve.js & npm start)
PORT=3000
NODE_ENV=development

# Web3Forms API-Schlüssel für das Kontaktformular (Kontakt.html)
# Ein öffentlich geteilter Test-Key oder dein eigener Access-Key
WEB3FORMS_ACCESS_KEY=aecf1c43-94a8-42e4-9d17-4a858d3d30ec

# Playwright Test-Konfiguration (Browser-Channel: chrome, msedge, etc.)
# Standardmäßig wird das installierte Google Chrome verwendet
PW_CHANNEL=chrome

# Vercel Deployment & CLI Verknüpfung (optional für Vercel CLI Deploys)
VERCEL_ORG_ID=team_BBgxWHYmlxILL4RsYraFEmmt
VERCEL_PROJECT_ID=prj_uqhqX4WjanFhnc5oMnW4Y0ZSzKRq
# VERCEL_TOKEN=dein-persoenlicher-vercel-token-fuer-ci-oder-cli
