{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.js 3000",
      "startServerReadyPattern": "3000",
      "url": [
        "http://localhost:3000/Home.html",
        "http://localhost:3000/Bildergalerie.html",
        "http://localhost:3000/Auftrag.html",
        "http://localhost:3000/Leistungen.html",
        "http://localhost:3000/Kontakt.html"
      ],
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.75, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
